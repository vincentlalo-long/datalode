# ==============================================================================
# Configuration Template
# Copy this file to .env and adjust paths for your local setup:
#   copy .env.example .env (Windows: copy / Linux: cp)
# ==============================================================================

# --- counterside source ---
# Path to CounterSide Data\StreamingAssets directory on your machine
CS_STREAMING_ASSETS_DIR=D:\Game\CounterSide\Game\CounterSide\Data\StreamingAssets

# Where extracted assets go (relative to repo root, or absolute).
# Default: data/counterside/outputs
# OUTPUT_DIR=data/counterside/outputs

# Where the organized dataset goes. Default: data/counterside/dataset
# DATASET_DIR=data/counterside/dataset
